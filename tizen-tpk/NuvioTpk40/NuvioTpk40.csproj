<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host do Nuvio para Tizen 4.0/5.0 (TVs 2018-2019). Sem GLWindow nessa
       API: por enquanto so carrega a libnuvio.so e diz na tela se a TV deixou.
       O manifesto declara um privilegio Partner para o Apps2Samsung assinar o
       pacote como Partner (WgtPrivileges.cs); com assinatura Public a TV
       recusou a .so no spike.2 (UEP). Ver tizen-tpk/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen40</TargetFramework>
    <RootNamespace>NuvioTpk</RootNamespace>
    <AssemblyName>NuvioTpk40</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program40.cs" />
    <PackageReference Include="Tizen.NET" Version="4.0.*"><ExcludeAssets>Runtime</ExcludeAssets></PackageReference>
    <PackageReference Include="Tizen.NET.Sdk" Version="1.1.*" />
  </ItemGroup>
</Project>
